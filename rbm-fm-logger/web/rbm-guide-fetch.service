[Unit]
Description=Save today's RBM programme guide for the download page
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rbmweb
Group=rbmweb
EnvironmentFile=/etc/rbm-web.conf
ExecStart=/usr/local/lib/rbm-web/rbm_guide_fetch.py
# Snapshots live in /var/lib/rbm-guide, readable by the download page.
StateDirectory=rbm-guide
StateDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
InaccessiblePaths=-/mnt/storage -/etc/rbm-logger.conf -/var/lib/rbm-logger
