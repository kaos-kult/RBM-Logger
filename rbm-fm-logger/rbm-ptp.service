[Unit]
Description=Dante (PTPv1) clock follower for the RBM studio recorder (Statime, Inferno fork)
Documentation=https://github.com/teodly/statime/tree/inferno-dev
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Statime keeps its own virtual clock (virtual-system-clock = true) and never adjusts the
# logger's real clock, which names the FM recordings. (ProtectClock can't be used here: it
# also blocks the read-only clock_adjtime calls Statime measures with, and the clock never
# settles. The studio recorder keeps ProtectClock.)
ExecStart=/usr/local/lib/rbm-dante/statime -c /etc/rbm-dante/statime.toml
Restart=always
RestartSec=5
# PTP uses UDP ports 319/320. CAP_DAC_OVERRIDE lets it answer the studio recorder's
# private (0750) clock socket in /run/rbm-dante.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The clock socket, shared with the studio recorder (which also puts its own reply
# socket here, through TMPDIR). Sticky and world-writable like /tmp, but only for this.
RuntimeDirectory=rbm-dante
RuntimeDirectoryMode=1777
RuntimeDirectoryPreserve=yes
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
